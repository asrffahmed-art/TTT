# THOTH Server Environment Variables
# ------------------------------------
# انسخ هذا الملف إلى .env ثم عبّي القيم، أو أضفها مباشرة في لوحة تحكم منصة النشر.

# ===== إلزامي =====
# مفتاح Gemini API من Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ===== اختياري =====
# المنفذ (يحدده تلقائياً Railway/Render عبر متغير PORT)
PORT=3000

# رابط التطبيق العام (يُستخدم في روابط الدفع وتأكيد الطلبات)
# APP_URL=https://thothai.site

# ===== البريد الإلكتروني (للـ OTP) =====
# الخيار 1: Resend (موصى به)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=THOTH <noreply@yourdomain.com>

# الخيار 2: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=THOTH <your@gmail.com>

# ===== إشعارات Web Push (W3C Push API + VAPID) =====
# المفتاح العام مضمّن في واجهة الموقع (public by design) — يُقرأ أيضًا من هنا
VAPID_PUBLIC_KEY=BF_5Ju24577yMXIdXX3w7JVD6GQa_GxIgCghh3PD1ha6ByHTHV6xzafJnV6mS284lgDo2rc9nc42YQioftFGCTQ
# المفتاح الخاص سري للغاية — لا ترفعه لأي مستودع عام
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:onq6974@gmail.com

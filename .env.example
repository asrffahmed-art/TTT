# THOTH Server Environment Variables
# ------------------------------------
# انسخ هذا الملف إلى .env ثم عبّي القيم، أو أضفها مباشرة في لوحة تحكم منصة النشر.

# ===== إلزامي =====
# مفتاح Gemini API من Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ===== اختياري =====
# المنفذ (يحدده تلقائياً Railway/Render عبر متغير PORT)
PORT=3000

# رابط التطبيق العام (يُستخدم في روابط الدفع وتأكيد الطلبات)
# APP_URL=https://thothai.site

# ===== البريد الإلكتروني (للـ OTP) =====
# الخيار 1: Resend (موصى به)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM=THOTH <noreply@yourdomain.com>

# الخيار 2: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=THOTH <your@gmail.com>

{
  "version": 2,
  "cleanUrls": true,
  "regions": ["iad1"],
  "buildCommand": "npm run vercel:build",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
